# URL da API do crm-backend. Em dev local o backend sobe na 3000 (ver crm-backend/.env.example).
VITE_API_URL=http://localhost:3000

# Opcional. Link do contato comercial mostrado na tela de plano (ex.: formulario ou mailto:). Sem ele,
# a tela orienta a falar com o contato comercial, sem link.
# VITE_SALES_CONTACT_URL=
